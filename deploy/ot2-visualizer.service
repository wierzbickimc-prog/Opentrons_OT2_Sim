[Unit]
Description=OT-2 Protocol Visualizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/Opentrons_OT2_Sim
EnvironmentFile=-%h/.config/ot2-visualizer.env
ExecStart=/usr/bin/python3 %h/apps/Opentrons_OT2_Sim/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
